# Testnet buyer secret key; used only by the payment client.
STELLAR_PRIVATE_KEY=

# Service recipient public key.
STELLAR_RECIPIENT=

# Used only to fund the recipient and create its trustline.
STELLAR_RECIPIENT_SECRET=

STELLAR_PORT=3001

# Optional client target. Omit to use the local service.
STELLAR_SERVICE_ORIGIN=http://127.0.0.1:3001
STELLAR_RESOURCE_ID=business-checklist

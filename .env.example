# Testnet buyer secret key; used only by the payment client.
STELLAR_PRIVATE_KEY=

# Service recipient public key.
STELLAR_RECIPIENT=

# Used only to fund the recipient and create its trustline.
STELLAR_RECIPIENT_SECRET=

STELLAR_PORT=3001

# Optional client target. Omit to use the local service.
STELLAR_SERVICE_ORIGIN=http://127.0.0.1:3001
STELLAR_RESOURCE_ID=business-checklist

# Automatic payments are disabled by default. Enable only with an explicit policy.
# When enabled, payments are auto-approved only when they are within this amount
# (atomic units) and within the remaining application budget; otherwise review is required.
STELLAR_AUTO_PAY=false
STELLAR_AUTO_PAY_MAX_AMOUNT_ATOMIC=100000
